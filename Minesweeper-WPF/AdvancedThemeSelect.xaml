<Window x:Class="Minesweeper_WPF.AdvancedThemeSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        Title="AdvancedThemeSelect" Height="450" Width="400">
    <Grid Background="#FFF0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Téma szerkesztése"
                    Margin="10,0,10,5"
                    Grid.Row="0"
                    FontWeight="Bold"
                    FontSize="16"/>

        <TextBlock Text="Választott elem módosítása"
                   x:Name="SelectedElement"
                   Margin="10,0,10,5"
                   Grid.Row="1"
                   FontSize="12"/>

        <WrapPanel x:Name="ThemeList"
                   Background="White"
                   Grid.Row="2"
                   Margin="10,0,10,0"
                   VerticalAlignment="Top"/>

        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="Canel" Content="Mégse" Height="20" Width="120" Margin="0,0,5,0" Click="Canel_Click"/>
            <Button x:Name="Save" Content="Mentés" Height="20" Width="120" Margin="5,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
