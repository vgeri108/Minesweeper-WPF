<Window x:Class="Minesweeper_WPF.Stats"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        Icon="/icon.ico"
        WindowStartupLocation="CenterOwner"
        Title="Aknakereső statisztikája - User" Height="200" Width="650">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Difficulties" SelectionChanged="Difficulties_SelectionChanged"/>

            <GroupBox Grid.Column="1" Header="Legjobb idők">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="NoStatTime" Text="999" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NoStatDate" Text="2026.01.09." TextWrapping="Wrap" Grid.Column="1"/>

                </Grid>
            </GroupBox>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="PlayedGames" Text="Jejátszott játékok: 0"/>
                <TextBlock x:Name="WinnedGames" Text="Megnyert játékok: 0"/>
                <TextBlock x:Name="WinPercenatee" Text="Nyerési arány: 000%"/>
                <TextBlock x:Name="LongestWinStreak" Text="Leghosszabb győzelemsorozat: 0"/>
                <TextBlock x:Name="LongestLoseStreak" Text="Leghosszabb vereségsorozat: 0"/>
                <TextBlock x:Name="CurrentStreak" Text="Jelenlegi sorozat: 0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="Close" Content="Bezárás" Width="120" Margin="0,0,5,0"/>
            <Button x:Name="Reset" Content="Alaphelyzetbe állítás" Width="120" Margin="5,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>
