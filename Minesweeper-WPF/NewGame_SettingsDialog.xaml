<Window x:Class="Minesweeper_WPF.NewGame_SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="/icon.ico"
        Title="A játék beállításai megváltoztak" Height="250" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ezek a beállítások nem alkalmazhatók a jelenleg folyó játékra. Mit szeretne tenni?"
           FontSize="16" Margin="0,0,20,20" Foreground="#FF0077B6" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">

            <Button Name="StartNew"
            HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#FF305995" Click="StartNew_Click">
                <StackPanel>
                    <TextBlock Text="➜ Kilépés és új játék indítása az új beállításokkal" FontSize="14"/>
                    <TextBlock Text="      Ez a statisztikában vereségnek számít." FontSize="12"/>
                </StackPanel>
            </Button>

            <Button Name="OnNextGame"
            HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" Foreground="#FF305995" BorderBrush="{x:Null}" Click="OnNextGame_Click">
                <StackPanel>
                    <TextBlock Text="➜ A játék befejezése" FontSize="14"/>
                    <TextBlock Text="Az új beállítások a következő játéktól kezdve lesznek érvényesek." Margin="20,0,0,0" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
