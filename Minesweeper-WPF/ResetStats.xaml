<Window x:Class="Minesweeper_WPF.ResetStats"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        Icon="/icon.ico"
        WindowStartupLocation="CenterOwner"
        Title="Statisztikák visszaállítása" Height="150" Width="450"
        Background="#FFF0F0F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Margin="10" HorizontalAlignment="Center" TextAlignment="Center">
            Biztosan törölni szeretné a statisztikáit? <LineBreak/>
            Ez a művelet nem vonható vissza.
        </TextBlock>
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button x:Name="Cancel" Content="Mégse" Width="100" Margin="10,10,5,10" Click="Cancel_Click"/>
            <Button x:Name="All" Content="Az összes nehézségen" Width="140" Margin="5,10,5,10" Click="All_Click"/>
            <Button x:Name="Selected" Content="Csak itt: Kiválasztott" Width="140" Margin="5,10,10,10" Click="Selected_Click"/>
        </StackPanel>
    </Grid>
</Window>
