<Window x:Class="Minesweeper_WPF.Tips"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="Tippek" Height="300" Width="550">
    <Border CornerRadius="20" Padding="20,20,20,10">
        <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="White"/>
                <GradientStop Color="#FFB8C8DE" Offset="0.9"/>
            </LinearGradientBrush>
        </Border.Background>

        <Viewbox VerticalAlignment="Top">
            <Grid MaxWidth="550" MaxHeight="300">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Title" Text="Tipp" FontSize="30" Foreground="#FF0077B6"/>
                    <Button x:Name="Close" Content="X" Grid.Column="1" VerticalAlignment="Top" Click="Close_Click"/>
                </Grid>

                <TextBlock x:Name="Description" Grid.Row="1" TextWrapping="Wrap" Text="Ne lépj aknára, mert akkor fel fogsz robbanni." FontSize="14"/>

                <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="5,30,5,0">
                    <Image Source="/infowarn1.png" Height="50"/>
                    <TextBlock Text="A tippeket a Beállítások párbeszédpanelen kapcsolhatja ki." FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Viewbox>
    </Border>
</Window>
