<Window x:Class="Minesweeper_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        Title="Aknakereső"
        Height="505"
        Width="460"
        MinHeight="260"
        MinWidth="260"
        Icon="/icon.ico"
        Closing="Window_Closing"
        Loaded="MainWindow_Loaded">

    <Grid>

        <!-- Háttér -->
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill"
                        x:Name="BackgroundImage"/>
        </Grid.Background>

        <!-- Sorok: menü + játék -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menü -->
        <Menu Grid.Row="0" Background="White">
            <MenuItem Header="Játék">
                <MenuItem Header="Új játék" x:Name="NewGame" Click="NewGame_Click"/>
                <Separator/>
                <MenuItem Header="Statisztika" x:Name="Stats" Click="Stats_Click"/>
                <MenuItem Header="Beállítások" x:Name="Settings" Click="Settings_Click"/>
                <MenuItem Header="Megjelenés módosítása" x:Name="AppearanceMenu" Click="Appearance_Click"/>
                <Separator/>
                <MenuItem Header="Kilépés" x:Name="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Beállítások">
                <MenuItem Header="Játék beállításai" Click="Settings_Click"/>
                <MenuItem Header="Alkalmazás beállításai" x:Name="AppSettings" Click="AppSettings_Click"/>
                <Separator/>
                <MenuItem Header="Frissítések keresése" x:Name="CheckForUpdates" Click="CheckForUpdates_Click"/>
            </MenuItem>
            <MenuItem Header="Súgó">
                <MenuItem Header="Súgó megjelenítése" x:Name="Help" Click="Help_Click"/>
                <Separator/>
                <MenuItem Header="Az aknakereső névjegye" x:Name="About" Click="About_Click"/>
                <Separator/>
                <MenuItem Header="További játékok az interneten" x:Name="MoreGames" Click="MoreGames_Click"/>
            </MenuItem>
        </Menu>

        <!-- JÁTÉKTÁBLA + ALSÓ PANEL KÖZÖS VIEWBOX-BAN -->
        <Viewbox Grid.Row="1"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="10">

            <!-- Referencia méret -->
            <Grid Width="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Játéktábla -->
                <UniformGrid x:Name="GameBoard"
                             Rows="5"
                             Columns="10"
                             Grid.Row="0"
                             Margin="0,0,0,10"/>

                <!-- Alsó információs sáv -->
                <DockPanel Grid.Row="1"
                           LastChildFill="True">

                    <!-- Bal oldal -->
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image x:Name="ClockImage"
                               Width="40"
                               Height="40"
                               Margin="0,0,8,0"/>

                        <Border x:Name="TimerBox"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                MinWidth="80">
                            <TextBlock x:Name="Timer"
                                       Text="0"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Jobb oldal -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="MineCounterBox"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                MinWidth="80"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="MineCounter"
                                       Text="10"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Image x:Name="FlowerImage"
                               Width="40"
                               Height="40"/>
                    </StackPanel>

                    <!-- Kitöltő -->
                    <Grid/>
                </DockPanel>

            </Grid>
        </Viewbox>

    </Grid>
</Window>
