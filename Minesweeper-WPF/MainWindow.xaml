<Window x:Class="Minesweeper_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        Title="Aknakereső" Height="505" Width="460">

    <Grid>
        <!-- Háttér -->
        <Grid.Background>
            <ImageBrush ImageSource="/hatter.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Sorok: menü, közös tartalom (tábla + alsó panel együtt skálázva) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menü -->
            <RowDefinition Height="*"/>
            <!-- Tartalom -->
        </Grid.RowDefinitions>

        <!-- Menü -->
        <Menu Grid.Row="0" Background="White">
            <MenuItem Header="Játék">
                <MenuItem Header="Új játék" x:Name="NewGame" Click="NewGame_Click"/>
                <Separator/>
                <MenuItem Header="Statisztika" x:Name="Stats" Click="Stats_Click"/>
                <MenuItem Header="Beállítások" x:Name="Settings" Click="Settings_Click"/>
                <MenuItem Header="Megjelenés módosítása" x:Name="AppearanceMenu" Click="Appearance_Click"/>
                <Separator/>
                <MenuItem Header="Kilépés" x:Name="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Súgó">
                <MenuItem Header="Súgó megjelenítése" x:Name="Help" Click="Help_Click"/>
                <Separator/>
                <MenuItem Header="Az aknakereső névjegye" x:Name="About" Click="About_Click"/>
                <Separator/>
                <MenuItem Header="További játékok az interneten" x:Name="MoreGames" Click="MoreGames_Click"/>
            </MenuItem>
        </Menu>

        <!-- Közös ViewBox: a pálya és az alsó panel együtt, arányosan skálázódik az ablakkal -->
        <Viewbox Grid.Row="1"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="{Binding ActualHeight,
                          RelativeSource={RelativeSource AncestorType=Window},
                          Converter={StaticResource WidthToMarginConverter}}">
            <!-- Alap layout méret: a ViewBox ezt skálázza fel/le -->
            <StackPanel Width="400">
                <!-- Játéktábla -->
                <UniformGrid x:Name="GameBoard"
                             Rows="9" Columns="9"
                             Width="400" Height="400"/>

                <!-- Alsó információs sáv: bal–jobb rögzítés, elemek a képek mellett -->
                <DockPanel Height="40" Margin="0,10,0,0" LastChildFill="True">
                    <!-- Bal csoport: óra + időszámláló közvetlen egymás mellett -->
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Source="/Assets/Images/GUI/Icons/clock.png"
                               Width="40" Height="40"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                        <Border Background="#31569C"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Width="80"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TimerDisplay"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Jobb csoport: aknaszámláló + virág közvetlen egymás mellett -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#31569C"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Width="80"
                                VerticalAlignment="Center"
                                Margin="0,0,5,0">
                            <TextBlock x:Name="MineCounter"
                                       Text="10"
                                       Foreground="White"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Image Source="/Assets/Images/GUI/Icons/flower.png"
                               Width="40" Height="40"
                               VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Középső kitöltő: üres tér, hogy a szélső csoportok ne csússzanak össze -->
                    <Grid/>
                </DockPanel>
            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
