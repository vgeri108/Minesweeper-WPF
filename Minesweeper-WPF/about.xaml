<Window x:Class="Minesweeper_WPF.about"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        MinWidth="500"
        MinHeight="450"
        ShowInTaskbar="False"
        Title="Aknakereső - névjegy" Height="450" Width="500" Icon="/icon.ico" ResizeMode="NoResize" Background="#FFF0F0F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image x:Name="Logo" Grid.Row="0" Margin="20" Source="/Assets/Themes/Default/Images/GUI/windows.png"/>
        <Separator Grid.Row="1"/>

        <Grid Grid.Row="2" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/icon.ico" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <TextBlock Grid.Column="2" TextWrapping="Wrap" Margin="20,0,30,0" x:Name="InfoText">
                Naquadah-Fusion
                <LineBreak/>
                Verzió: 6.2
                <LineBreak/>
                © 2026 Naquadah-Fusion. Minden jog fenntartva.
                <LineBreak/>
                Ez a szoftver nyílt forráskódú, szabadon felhasználható, módosítható és terjeszthető a MIT licenc feltételei szerint.
                <LineBreak/>
                <LineBreak/>
                Aknakereső - Fejlesztő: Naquadah-Fusion
                <LineBreak/>
                <LineBreak/>
                A termék a MIT licenc feltételei alá esik.
                A termék használatára jogosult: 
                <LineBreak/>
                <LineBreak/>
                User
            </TextBlock>
        </Grid>
        <Button Grid.Row="3" Content="OK" Height="25" Width="90" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15,15,35,15" Click="OK_click"/>
    </Grid>
</Window>
