<Window x:Class="Minesweeper_WPF.NewGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beállítások"
        Width="430"
        Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12" ShowInTaskbar="False" Topmost="True" WindowStyle="ToolWindow">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- NEHÉZSÉGI SZINT -->
        <GroupBox Header="Nehézségi szint" Grid.Row="0">
            <Grid Margin="10">

                <!-- 2 oszlop: bal oldali rádiók + jobb oldali egyéni -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <!-- bal oldali rádiók -->
                    <ColumnDefinition Width="0"/>
                    <!-- minimális távolság -->
                    <ColumnDefinition Width="*"/>
                    <!-- jobb oldali egyéni -->
                </Grid.ColumnDefinitions>

                <!-- Bal oldali 3 rádió -->
                <StackPanel Grid.Column="0" Orientation="Vertical">

                    <RadioButton Margin="0,0,0,8" VerticalContentAlignment="Center" IsChecked="True">
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Text="Kezdő"/>
                            <TextBlock Text="10 akna"/>
                            <TextBlock Text="9 × 9-es rács"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Margin="0,0,0,8" VerticalContentAlignment="Center">
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Text="Középhaladó"/>
                            <TextBlock Text="40 akna"/>
                            <TextBlock Text="16 × 16-os rács"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Margin="0,0,0,0" VerticalContentAlignment="Center">
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Text="Haladó"/>
                            <TextBlock Text="99 akna"/>
                            <TextBlock Text="16 × 30-as rács"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <!-- Jobb oldali Egyéni + mezők -->
                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0">

                    <!-- Egyéni radiobutton -->
                    <RadioButton x:Name="rbCustom"
                                 Content="Egyéni"
                                 Margin="0,0,0,10"/>

                    <!-- Egyéni mezők -->
                    <Grid Margin="10,0,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <!-- címkék -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- textboxok -->
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Magasság -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                 Text="Magasság (9–14):"
                                 Margin="0,0,5,5"
                                 IsEnabled="{Binding IsChecked, ElementName=rbCustom}"/>

                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Width="50"
                                 Height="20"
                                 x:Name="tbHeight"
                                 IsEnabled="{Binding IsChecked, ElementName=rbCustom}"
                                 Margin="0,0,0,5" Text="9"/>

                        <!-- Szélesség -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Szélesség (9–30):"
                                   Margin="0,0,5,5"/>

                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Width="50"
                                 Height="20"
                                 x:Name="tbWidth"
                                 IsEnabled="{Binding IsChecked, ElementName=rbCustom}"
                                 Margin="0,0,0,5" Text="9"/>

                        <!-- Aknák -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Aknák (10-668):"
                                   Margin="0,0,5,0"/>

                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Width="50"
                                 Height="20"
                                 x:Name="tbMines"
                                 IsEnabled="{Binding IsChecked, ElementName=rbCustom}" Text="10"/>

                    </Grid>

                </StackPanel>

            </Grid>
        </GroupBox>

        <!-- EGYÉB BEÁLLÍTÁSOK – NEM CSOPORTOSÍTVA -->
        <StackPanel Grid.Row="2">

            <CheckBox Margin="0,0,0,8" IsChecked="True">
                <TextBlock Text="Animációk megjelenítése"/>
            </CheckBox>
            <CheckBox Margin="0,0,0,8" IsChecked="True" >
                <TextBlock Text="Hangok lejátszása"/>
            </CheckBox>
            <CheckBox Margin="0,0,0,8" IsChecked="True">
                <TextBlock Text="Tippek megjelenítése"/>
            </CheckBox>
            <CheckBox Margin="0,0,0,8">
                <TextBlock Text="Mindig a mentett játék folytatása"/>
            </CheckBox>
            <CheckBox Margin="0,0,0,8">
                <TextBlock Text="Kilépéskor mindig mentse a játékot"/>
            </CheckBox>
            <CheckBox Margin="0,0,0,0" IsChecked="True">
                <TextBlock Text="Kérdőjelek engedélyezése (kétszer kattintás a jobb egérgombbal)"
                           TextWrapping="Wrap"/>
            </CheckBox>

        </StackPanel>

        <!-- GOMBOK -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,10,0"/>
            <Button Content="Mégse" Width="80"/>
        </StackPanel>

    </Grid>
</Window>
