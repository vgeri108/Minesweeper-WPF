<Window x:Class="Minesweeper_WPF.NewGame_MenuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        Icon="/icon.ico"
        ResizeMode="NoResize"
        Title="Új játék" Height="260" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Mit szeretne tenni a folyamatban levő játékkal?"
               FontSize="16" Margin="0,0,0,20" Foreground="#FF0077B6" />

        <StackPanel Grid.Row="1" VerticalAlignment="Top">

            <Button Name="StartNew"
                HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#FF305995" Click="StartNew_Click">
                <StackPanel>
                    <TextBlock Text="➜ Kilépés és új játék indítása" FontSize="14"/>
                    <TextBlock Text="     Ez a statisztikában vereségnek számít." FontSize="12"/>
                </StackPanel>
            </Button>

            <Button Name="Replay"
                HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" Foreground="#FF305995" BorderBrush="{x:Null}" Click="Replay_Click">
                <StackPanel>
                    <TextBlock Text="➜ Újrakezdem ezt a játékot" FontSize="14"/>
                    <TextBlock Text="      Ez a statisztikában vereségnek számít." FontSize="12"/>
                </StackPanel>
            </Button>

            <Button Name="Continue"
                HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" Foreground="#FF305995" BorderBrush="{x:Null}" Click="Continue_Click">
                <StackPanel>
                    <TextBlock Text="➜ Folytatom a játékot" FontSize="14"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
