<Window x:Class="Minesweeper_WPF.RenameMode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Név módosítása" Height="140" Width="350" WindowStartupLocation="CenterOwner"
        Background="#FFF0F0F0">
    <StackPanel Margin="10">
        <TextBlock x:Name="CurrentLabel" FontWeight="Bold"/>
        <TextBox x:Name="InputBox" Margin="0,5,0,0" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="60" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Mégse" Width="60" Margin="5,0,0,0" Click="Cancel_Click" IsCancel="True" />
        </WrapPanel>
    </StackPanel>
</Window>