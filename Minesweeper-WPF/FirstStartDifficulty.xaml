<Window x:Class="Minesweeper_WPF.FirstStartDifficulty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        Title="Select Difficulty" Height="450" Width="450" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cím -->
        <TextBlock Text="What level of difficulty do you want to play?"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Foreground="#FF305995"/>

        <!-- Gombok stackpanelben -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">

            <Button Name="BeginnerButton" Click="NewBeginner"
                    HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" BorderBrush="#FF305995" Foreground="#FF0077B6">
                <StackPanel>
                    <TextBlock Text="➜ Beginner" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="     10 mines, 9 x 9 tile grid" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button Name="IntermediateButton" Click="NewIntermediate"
                    HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" BorderBrush="#FF305995" Foreground="#FF0077B6">
                <StackPanel>
                    <TextBlock Text="➜ Intermediate" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="      40 mines, 16 x 16 tile grid" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button Name="AdvancedButton" Click="NewAdvanced"
                    HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" BorderBrush="#FF305995" Foreground="#FF0077B6">
                <StackPanel>
                    <TextBlock Text="➜ Advanced" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="     99 mines, 16 x 30 tile grid" FontSize="12"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Megjegyzés -->
        <TextBlock Grid.Row="2" Text="Note: You can change the difficulty level later by clicking Options on the Main Menu"
                   FontSize="12" TextWrapping="Wrap" Margin="-19,10,-19,-19" Background="#FFE2E2E2" VerticalAlignment="Top" Height="30"/>
    </Grid>
</Window>
