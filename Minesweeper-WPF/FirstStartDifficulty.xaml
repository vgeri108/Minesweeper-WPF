<Window x:Class="Minesweeper_WPF.FirstStartDifficulty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper_WPF"
        mc:Ignorable="d"
        Icon="/icon.ico"
        WindowStartupLocation="CenterScreen"
        Title="Nehézségi fok kiválasztása" Height="330" Width="420" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cím -->
        <TextBlock Text="Milyen nehézségi fokon kíván játszani?"
                   FontSize="16" Margin="0,0,0,20" Foreground="#FF0077B6"/>

        <!-- Gombok stackpanelben -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">

            <Button Name="BeginnerButton" Click="NewBeginner"
                    HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#FF305995">
                <StackPanel>
                    <TextBlock Text="➜ Kezdő" FontSize="14"/>
                    <TextBlock Text="     10 akna, 9 x 9-es rács" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button Name="IntermediateButton" Click="NewIntermediate"
                    HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" Foreground="#FF305995" BorderBrush="{x:Null}">
                <StackPanel>
                    <TextBlock Text="➜ Középhaladó" FontSize="14"/>
                    <TextBlock Text="      40 akna, 16 x 16-es rács" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button Name="AdvancedButton" Click="NewAdvanced"
                    HorizontalContentAlignment="Left" Padding="10" Background="{x:Null}" Foreground="#FF305995" BorderBrush="{x:Null}">
                <StackPanel>
                    <TextBlock Text="➜ Haladó" FontSize="14"/>
                    <TextBlock Text="     99 akna, 16 x 30-es rács" FontSize="12"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Megjegyzés -->
        <TextBlock Grid.Row="2" Text="Megjegyzés: A nehézségi szint később is módosítható a Játék menü Beállítások parancsára kattintva."
                   FontSize="12" TextWrapping="Wrap" Margin="-9,0,-9,-9" Background="#FFE2E2E2" VerticalAlignment="Top" Height="40"
                   Padding="5"/>
    </Grid>
</Window>
